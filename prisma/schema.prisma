generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                @id @default(cuid())
  firebaseUid     String                @unique
  email           String?
  name            String?
  imageUrl        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  projects        Project[]
  workspaces      Workspace[]
  comments        Comment[]
  shareLinks      ShareLink[]
  memberships     WorkspaceMembership[]
  sentInvitations WorkspaceInvitation[]
}

model Workspace {
  id                     String               @id @default(cuid())
  name                   String
  ownerUserId            String
  ownerUser              User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  currentPlanId          String               @default("free")
  razorpayCustomerId     String?              @unique
  razorpaySubscriptionId String?              @unique
  subscriptionStatus     String               @default("none")
  currentPlanStartedAt   DateTime?
  currentPlanRenewsAt    DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  projects               Project[]
  billingWebhookEvents   BillingWebhookEvent[]
  memberships            WorkspaceMembership[]
  invitations            WorkspaceInvitation[]
  documents              Document[]
  shareLinks             ShareLink[]

  @@index([ownerUserId])
}

// Role values: OWNER | ADMIN | EDITOR | COMMENTER | VIEWER
// (string column to match existing convention, e.g. ShareLink.access)
model WorkspaceMembership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("VIEWER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Status values: PENDING | ACCEPTED | REVOKED
model WorkspaceInvitation {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  role            String    @default("VIEWER")
  token           String    @unique @default(cuid())
  status          String    @default("PENDING")
  invitedByUserId String?
  invitedByUser   User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([email, status])
}

model Project {
  id         String      @id @default(cuid())
  name       String
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace  Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  documents  Document[]
  shareLinks ShareLink[]

  @@index([ownerId, updatedAt])
  @@index([workspaceId, updatedAt])
}

model Document {
  id           String       @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  isVisible    Boolean      @default(true)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  annotations  Annotation[]
  comments     Comment[]
  shareLinks   ShareLink[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([workspaceId])
}

model Annotation {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  type       String
  geometry   Json
  style      Json
  content    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]
}

model Comment {
  id           String      @id @default(cuid())
  content      String
  documentId   String
  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  annotationId String?
  annotation   Annotation? @relation(fields: [annotationId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String?
  pageNumber   Int
  resolved     Boolean     @default(false)
  // Internal comments are only visible to workspace members (never via share links)
  isInternal   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ShareLink {
  id              String    @id @default(cuid())
  token           String    @unique @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  access          String    @default("VIEW")
  // sha256 hash — link is public when null
  passwordHash    String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([workspaceId])
}

model BillingWebhookEvent {
  id                 String     @id @default(cuid())
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  razorpayEventId    String?    @unique
  razorpayEntityId   String?
  event              String
  payload            Json
  createdAt          DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([event, createdAt])
}
