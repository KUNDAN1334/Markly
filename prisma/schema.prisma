generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  firebaseUid         String               @unique
  email               String?
  name                String?
  imageUrl            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  projects            Project[]
  workspaces          Workspace[]
  comments            Comment[]
  commentStatusEvents CommentStatusEvent[]
  shareLinks          ShareLink[]
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  ownerUserId String
  ownerUser   User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([ownerUserId])
}

model Project {
  id          String      @id @default(cuid())
  name        String
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  documents   Document[]
  shareLinks  ShareLink[]

  @@index([ownerId, updatedAt])
  @@index([workspaceId, updatedAt])
}

model Document {
  id           String       @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  isVisible    Boolean      @default(true)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  annotations  Annotation[]
  comments     Comment[]
  shareLinks   ShareLink[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId, createdAt])
}

model Annotation {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  type       String
  geometry   Json
  style      Json
  content    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]
}

model Comment {
  id           String               @id @default(cuid())
  content      String
  documentId   String
  document     Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  annotationId String?
  annotation   Annotation?          @relation(fields: [annotationId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String?
  pageNumber   Int
  // Kept in sync with status (true only when VERIFIED) for older clients.
  resolved     Boolean              @default(false)
  status       CommentStatus        @default(OPEN)
  statusEvents CommentStatusEvent[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// OPEN: flagged, waiting on the owner. FIXED: owner says it's addressed.
// VERIFIED: the reviewer confirmed the fix.
enum CommentStatus {
  OPEN
  FIXED
  VERIFIED
}

model CommentStatusEvent {
  id          String        @id @default(cuid())
  commentId   String
  comment     Comment       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fromStatus  CommentStatus
  toStatus    CommentStatus
  note        String?
  actorUserId String?
  actorUser   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String?
  createdAt   DateTime      @default(now())

  @@index([commentId, createdAt])
}

model ShareLink {
  id              String    @id @default(cuid())
  token           String    @unique @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  access          String    @default("VIEW")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
}
